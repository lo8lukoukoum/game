<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.gameshare.repository.CollectionMapper">

    <resultMap id="CollectionResultMap" type="com.example.gameshare.model.Collection">
        <id property="id" column="coll_id"/>
        <result property="userId" column="coll_user_id"/>
        <result property="gameId" column="coll_game_id"/>
        <result property="collectedAt" column="coll_collected_at"/>
        <association property="user" javaType="com.example.gameshare.model.User">
            <id property="id" column="u_id"/>
            <result property="username" column="u_username"/>
            <!-- Add other user fields if needed -->
        </association>
        <association property="game" javaType="com.example.gameshare.model.Game">
            <id property="id" column="g_id"/>
            <result property="name" column="g_name"/>
            <result property="imageUrl" column="g_image_url"/>
            <!-- Add other game fields if needed, e.g., category for display -->
            <association property="category" javaType="com.example.gameshare.model.Category">
                 <id property="id" column="cat_id"/>
                 <result property="name" column="cat_name"/>
            </association>
        </association>
    </resultMap>

    <sql id="collectionColumns">
        coll.id as coll_id,
        coll.user_id as coll_user_id,
        coll.game_id as coll_game_id,
        coll.collected_at as coll_collected_at
    </sql>

    <sql id="userBasicColumnsForCollection"> <!-- Renamed for clarity -->
        u.id as u_id,
        u.username as u_username
    </sql>

    <sql id="gameBasicColumnsForCollection"> <!-- Renamed for clarity -->
        g.id as g_id,
        g.name as g_name,
        g.image_url as g_image_url,
        g.category_id as g_category_id <!-- Needed for category join -->
    </sql>

    <sql id="categoryBasicColumnsForCollectionGame">
        cat.id as cat_id,
        cat.name as cat_name
    </sql>

    <select id="findByUserId" resultMap="CollectionResultMap">
        SELECT
          <include refid="collectionColumns"/>,
          <include refid="userBasicColumnsForCollection"/>,
          <include refid="gameBasicColumnsForCollection"/>,
          <include refid="categoryBasicColumnsForCollectionGame"/>
        FROM collections coll
        LEFT JOIN users u ON coll.user_id = u.id
        LEFT JOIN games g ON coll.game_id = g.id
        LEFT JOIN categories cat ON g.category_id = cat.id
        WHERE coll.user_id = #{userId}
        ORDER BY coll.collected_at DESC
    </select>

    <select id="findByUserIdAndGameId" resultMap="CollectionResultMap">
        SELECT
          <include refid="collectionColumns"/>,
          <include refid="userBasicColumnsForCollection"/>,
          <include refid="gameBasicColumnsForCollection"/>,
          <include refid="categoryBasicColumnsForCollectionGame"/>
        FROM collections coll
        LEFT JOIN users u ON coll.user_id = u.id
        LEFT JOIN games g ON coll.game_id = g.id
        LEFT JOIN categories cat ON g.category_id = cat.id
        WHERE coll.user_id = #{userId} AND coll.game_id = #{gameId}
    </select>

    <insert id="insert" parameterType="com.example.gameshare.model.Collection" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO collections (user_id, game_id, collected_at)
        VALUES (#{userId}, #{gameId}, #{collectedAt, jdbcType=TIMESTAMP})
    </insert>

    <delete id="delete">
        DELETE FROM collections WHERE id = #{id}
    </delete>

    <delete id="deleteByUserIdAndGameId">
        DELETE FROM collections WHERE user_id = #{userId} AND game_id = #{gameId}
    </delete>

</mapper>
