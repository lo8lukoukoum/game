<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.gameshare.repository.CommentMapper">

    <resultMap id="CommentResultMap" type="com.example.gameshare.model.Comment">
        <id property="id" column="c_id"/>
        <result property="content" column="c_content"/>
        <result property="userId" column="c_user_id"/>
        <result property="gameId" column="c_game_id"/>
        <result property="createdAt" column="c_created_at"/>
        <result property="updatedAt" column="c_updated_at"/>
        <association property="user" javaType="com.example.gameshare.model.User">
            <id property="id" column="u_id"/>
            <result property="username" column="u_username"/>
            <result property="email" column="u_email"/> <!-- Include other user fields if needed -->
        </association>
    </resultMap>

    <sql id="commentColumns">
        c.id as c_id,
        c.content as c_content,
        c.user_id as c_user_id,
        c.game_id as c_game_id,
        c.created_at as c_created_at,
        c.updated_at as c_updated_at
    </sql>

    <sql id="userBasicColumnsForComment"> <!-- Renamed for clarity -->
        u.id as u_id,
        u.username as u_username,
        u.email as u_email
    </sql>

    <select id="findById" resultMap="CommentResultMap">
        SELECT
          <include refid="commentColumns"/>,
          <include refid="userBasicColumnsForComment"/>
        FROM comments c
        LEFT JOIN users u ON c.user_id = u.id
        WHERE c.id = #{id}
    </select>

    <select id="findByGameId" resultMap="CommentResultMap">
        SELECT
          <include refid="commentColumns"/>,
          <include refid="userBasicColumnsForComment"/>
        FROM comments c
        LEFT JOIN users u ON c.user_id = u.id
        WHERE c.game_id = #{gameId}
        ORDER BY c.created_at DESC
    </select>

    <select id="findByUserId" resultMap="CommentResultMap">
        SELECT
          <include refid="commentColumns"/>,
          <include refid="userBasicColumnsForComment"/>
        FROM comments c
        LEFT JOIN users u ON c.user_id = u.id
        WHERE c.user_id = #{userId}
        ORDER BY c.created_at DESC
    </select>

    <insert id="insert" parameterType="com.example.gameshare.model.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comments (content, user_id, game_id, created_at, updated_at)
        VALUES (#{content}, #{userId}, #{gameId}, #{createdAt, jdbcType=TIMESTAMP}, #{updatedAt, jdbcType=TIMESTAMP})
    </insert>

    <delete id="delete">
        DELETE FROM comments WHERE id = #{id}
    </delete>

</mapper>
