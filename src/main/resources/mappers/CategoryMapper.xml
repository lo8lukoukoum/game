<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.gameshare.repository.CategoryMapper">

    <resultMap id="CategoryResultMap" type="com.example.gameshare.model.Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="CategoryResultMap">
        SELECT id, name, description, created_at, updated_at FROM categories WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="CategoryResultMap">
        SELECT id, name, description, created_at, updated_at FROM categories ORDER BY id
    </select>

    <insert id="insert" parameterType="com.example.gameshare.model.Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (name, description, created_at, updated_at)
        VALUES (#{name}, #{description}, #{createdAt, jdbcType=TIMESTAMP}, #{updatedAt, jdbcType=TIMESTAMP})
    </insert>

    <update id="update" parameterType="com.example.gameshare.model.Category">
        UPDATE categories
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt, jdbcType=TIMESTAMP},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM categories WHERE id = #{id}
    </delete>

</mapper>
