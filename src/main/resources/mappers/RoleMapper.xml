<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.gameshare.repository.RoleMapper">

    <resultMap id="RoleResultMap" type="com.example.gameshare.model.Role">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="findById" resultMap="RoleResultMap">
        SELECT id, name FROM roles WHERE id = #{id}
    </select>

    <select id="findByName" resultMap="RoleResultMap">
        SELECT id, name FROM roles WHERE name = #{roleName}
    </select>

    <insert id="insert" parameterType="com.example.gameshare.model.Role" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO roles (name) VALUES (#{name})
    </insert>

    <select id="findAll" resultMap="RoleResultMap">
        SELECT id, name FROM roles ORDER BY id
    </select>

</mapper>
