<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.gameshare.repository.RatingMapper">

    <resultMap id="RatingResultMap" type="com.example.gameshare.model.Rating">
        <id property="id" column="id"/>
        <result property="score" column="score"/>
        <result property="userId" column="user_id"/>
        <result property="gameId" column="game_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByGameId" resultMap="RatingResultMap">
        SELECT id, score, user_id, game_id, created_at, updated_at
        FROM ratings
        WHERE game_id = #{gameId}
    </select>

    <select id="findByUserIdAndGameId" resultMap="RatingResultMap">
        SELECT id, score, user_id, game_id, created_at, updated_at
        FROM ratings
        WHERE user_id = #{userId} AND game_id = #{gameId}
    </select>

    <insert id="insert" parameterType="com.example.gameshare.model.Rating" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ratings (score, user_id, game_id, created_at, updated_at)
        VALUES (#{score}, #{userId}, #{gameId}, #{createdAt, jdbcType=TIMESTAMP}, #{updatedAt, jdbcType=TIMESTAMP})
    </insert>

    <update id="update" parameterType="com.example.gameshare.model.Rating">
        UPDATE ratings
        <set>
            <if test="score != null">score = #{score},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt, jdbcType=TIMESTAMP},</if>
        </set>
        WHERE id = #{id}
        <!-- Or update based on user_id and game_id if ID is not reliably set before update -->
        <!-- WHERE user_id = #{userId} AND game_id = #{gameId} -->
    </update>

</mapper>
